   "source": [
    "def myNaivePQ(p, q):\n",
    "    return (p+(p**2-q)**0.5, p-(p**2-q)**0.5)"
   ],
   "outputs": [],
   "execution_count": 1
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-08T14:13:37.620773Z",
     "start_time": "2026-11-08T14:13:37.612286Z"
    }
   },
   "cell_type": "code",
   "source": [
    "import math\n",
    "def myPQ(p, q):\n",
    "    w = (p*p - q)**0.5\n",
    "    x1 = p + math.copysign(w, p)\n",
    "    x2 = q / x1\n",
    "    return x1, x2\n",
    "\n",
    "print(myNaivePQ(1e7, 1.0))\n",
    "print(myPQ(1e7, 1.0))"
   ],
